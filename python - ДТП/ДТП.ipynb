   "source": [
    "# МОСКОВСКАЯ ОБЛАСТЬ\n",
    "# фильтруем только водителей\n",
    "drivers_mos = Moscowskaya_oblast_participiants[Moscowskaya_oblast_participiants['role'] == 'Водитель'].copy()\n",
    "\n",
    "# Создание категорий стажа\n",
    "def categorize_experience(years):\n",
    "    if pd.isna(years):\n",
    "        return 'Стаж не указан'\n",
    "    elif years < 1:\n",
    "        return 'Менее 1 года'\n",
    "    elif years < 3:\n",
    "        return '1-3 года'\n",
    "    elif years < 5:\n",
    "        return '3-5 лет'\n",
    "    elif years < 10:\n",
    "        return '5-10 лет'\n",
    "    elif years < 15:\n",
    "        return '10-15 лет'\n",
    "    elif years < 20:\n",
    "        return '15-20 лет'\n",
    "    elif years < 30:\n",
    "        return '20-30 лет'\n",
    "    else:\n",
    "        return 'Более 30 лет'\n",
    "\n",
    "drivers_mos['experience_category'] = drivers_mos['years_of_driving_experience'].apply(categorize_experience)\n",
    "category_order = ['Менее 1 года', '1-3 года', '3-5 лет', '5-10 лет', \n",
    "                  '10-15 лет', '15-20 лет', '20-30 лет', 'Более 30 лет', 'Стаж не указан']\n",
    "dtp_by_experience_mos = drivers_mos.groupby('experience_category')['id'].nunique()\n",
    "\n",
    "dtp_by_experience_mos"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Здесь важно учитывать, какое число водителей есть в каждой когорте, однако таких сведений у нас нет. Однако можно заметить, что больше всего аварий у водителей со стажем 5-10 лет в обоих областях."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "muKT0SVzGKtA"
   },
   "source": [
    "### Как менялось число аварий в Кировской (Киров входит в численность) и Московской области (Москва исключена). Где аварий больше в относительном выражении — в пересчёте на 100 тысяч жителей"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Год    Кировская обл.       Московская обл.      Кировская (на 100к)  Московская (на 100к)\n",
      "2015   1,532                6,643                135.49               77.32               \n",
      "2016   1,468                5,794                129.83               67.44               \n",
      "2017   1,452                5,747                128.41               66.89               \n",
      "2018   1,612                5,102                142.56               59.38               \n",
      "2019   1,568                5,111                138.67               59.49               \n",
      "2020   1,498                4,216                132.48               49.07               \n",
      "2021   1,524                3,898                134.78               45.37               \n",
      "2022   1,386                3,353                122.58               39.03               \n",
      "2023   1,486                3,372                131.42               39.25               \n",
      "2024   991                  2,382                87.64                27.72               \n"
     ]
    }
   ],
   "source": [
    "# Извлечение года и месяца\n",
    "for df in [Kirovskaya_oblast, Moscowskaya_oblast]:\n",
    "    df['year'] = df['properties_datetime'].dt.year\n",
    "    df['month'] = df['properties_datetime'].dt.month\n",
    "    df['year_month'] = df['properties_datetime'].dt.to_period('M')\n",
    "    \n",
    "# Данные о численности населения (на 2023 год)\n",
    "population_data = {\n",
    "    'Кировская область': {\n",
    "        'население': 1130717,  \n",
    "        'регион': 'Кировская область'\n",
    "    },\n",
    "    'Московская область': {\n",
    "        'население': 8591736,   #(без Москвы)\n",
    "        'регион': 'Московская область'\n",
    "    }}\n",
    "\n",
    "# Добавление населения в датафреймы\n",
    "Kirovskaya_oblast['region'] = 'Кировская область'\n",
    "Kirovskaya_oblast['population'] = population_data['Кировская область']['население']\n",
    "Moscowskaya_oblast['region'] = 'Московская область'\n",
    "Moscowskaya_oblast['population'] = population_data['Московская область']['население']\n",
    "\n",
    "# Подсчет ДТП по годам\n",
    "dtp_by_year_kirov = Kirovskaya_oblast.groupby('year').size()\n",
    "dtp_by_year_moscow = Moscowskaya_oblast.groupby('year').size()\n",
    "\n",
    "# Расчет на 100 тысяч населения\n",
    "dtp_per_100k_kirov = (dtp_by_year_kirov / population_data['Кировская область']['население']) * 100000\n",
    "dtp_per_100k_moscow = (dtp_by_year_moscow / population_data['Московская область']['население']) * 100000\n",
    "\n",
    "print(f\"{'Год':<6} {'Кировская обл.':<20} {'Московская обл.':<20} {'Кировская (на 100к)':<20} {'Московская (на 100к)':<20}\")\n",
    "\n",
    "all_years = sorted(set(dtp_by_year_kirov.index) | set(dtp_by_year_moscow.index))\n",
    "for year in all_years:\n",
    "    kirov_count = dtp_by_year_kirov.get(year, 0)\n",
    "    moscow_count = dtp_by_year_moscow.get(year, 0)\n",
    "    kirov_per_100k = dtp_per_100k_kirov.get(year, 0)\n",
    "    moscow_per_100k = dtp_per_100k_moscow.get(year, 0)\n",
    "    print(f\"{year:<6} {kirov_count:<20,} {moscow_count:<20,} {kirov_per_100k:<20.2f} {moscow_per_100k:<20.2f}\")"
   ]
  },
