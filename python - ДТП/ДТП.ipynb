   "source": [
    "### Категории водителей по стажу. Встречаются ли категории, которые разительно отличаются по числу ДТП"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "metadata": {
    "scrolled": true
   },
   "outputs": [
    {
     "data": {
      "text/plain": [
       "experience_category\n",
       "1-3 года           947\n",
       "10-15 лет         1849\n",
       "15-20 лет         1607\n",
       "20-30 лет         1945\n",
       "3-5 лет            966\n",
       "5-10 лет          2137\n",
       "Более 30 лет      1693\n",
       "Стаж не указан    1881\n",
       "Name: id, dtype: int64"
      ]
     },
     "execution_count": 16,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# КИРОВСКАЯ ОБЛАСТЬ\n",
    "# фильтруем только водителей\n",
    "drivers_kir = Kirovskaya_oblast_participiants[Kirovskaya_oblast_participiants['role'] == 'Водитель'].copy()\n",
    "\n",
    "# Создание категорий стажа\n",
    "def categorize_experience(years):\n",
    "    if pd.isna(years):\n",
    "        return 'Стаж не указан'\n",
    "    elif years < 1:\n",
    "        return 'Менее 1 года'\n",
    "    elif years < 3:\n",
    "        return '1-3 года'\n",
    "    elif years < 5:\n",
    "        return '3-5 лет'\n",
    "    elif years < 10:\n",
    "        return '5-10 лет'\n",
    "    elif years < 15:\n",
    "        return '10-15 лет'\n",
    "    elif years < 20:\n",
    "        return '15-20 лет'\n",
    "    elif years < 30:\n",
    "        return '20-30 лет'\n",
    "    else:\n",
    "        return 'Более 30 лет'\n",
    "\n",
    "drivers_kir['experience_category'] = drivers_kir['years_of_driving_experience'].apply(categorize_experience)\n",
    "category_order = ['Менее 1 года', '1-3 года', '3-5 лет', '5-10 лет', \n",
    "                  '10-15 лет', '15-20 лет', '20-30 лет', 'Более 30 лет', 'Стаж не указан']\n",
    "dtp_by_experience_kir = drivers_kir.groupby('experience_category')['id'].nunique()\n",
    "\n",
    "dtp_by_experience_kir"
   ]
  },
